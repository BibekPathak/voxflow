# ============================================================================
# VoxFlow configuration
# Copy to .env and adjust. Never commit the real .env.
# ============================================================================

# --- Application ------------------------------------------------------------
VOXFLOW_ENV=development
LOG_LEVEL=INFO
JSON_LOGS=false

# --- Audio pipeline ---------------------------------------------------------
# Microphone audio is resampled in the browser to a fixed rate and sent as raw
# little-endian Int16 PCM over the audio WebSocket.
SAMPLE_RATE=16000
AUDIO_FRAME_MS=20
AUDIO_QUEUE_MAXSIZE=1024

# --- Voice Activity Detection ----------------------------------------------
VAD_SENSITIVITY=mock            # mock | energy (silero optional, later)
VAD_SPEECH_START_RMS=0.015      # amplitude RMS above which speech onset fires
VAD_SPEECH_END_RMS=0.010        # amplitude RMS below which speech offset fires
VAD_START_CONFIRM_MS=180        # speech must persist this long to confirm onset
VAD_END_CONFIRM_MS=450          # silence must persist this long to confirm offset
VAD_FRAME_MS=20

# --- Turn detection / endpointing -------------------------------------------
TURN_SILENCE_MS=750             # silence after speech end before turn submission
TURN_MIN_SPEECH_MS=400
TURN_MAX_UTTERANCE_S=30
TURN_AUTO_SUBMIT_MS=2500        # ignore trailing non-lexical partials faster than this
TURN_PAUSE_WINDOW_MS=600        # mid-utterance pause tolerated before endpointing

# --- Barge-in / interruption ------------------------------------------------
BARGE_IN_ENABLED=true
BARGE_IN_SPEECH_START_RMS=0.02
BARGE_IN_CANCEL_TTS=true
BARGE_IN_CANCEL_LLM=true

# --- Provider selection -----------------------------------------------------
# mock providers run with no external keys; swap per-service to real adapters.
PROVIDER_STT=mock               # mock | deepgram
PROVIDER_LLM=mock               # mock | openai
PROVIDER_TTS=mock               # mock | cartesia | elevenlabs

# --- Real provider credentials (optional) ------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_ENDPOINT=wss://api.deepgram.com/v1/listen

OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-2
CARTESIA_VOICE_ID=
CARTESIA_WS_URL=wss://api.cartesia.ai/tts/websocket

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- Provider runtime behavior ----------------------------------------------
PROVIDER_STT_TIMEOUT_S=15
PROVIDER_LLM_TIMEOUT_S=30
PROVIDER_TTS_TIMEOUT_S=20
PROVIDER_MAX_RETRIES=2
TOOL_TIMEOUT_S=10
TOOL_MAX_RETRIES=1

# --- Conversation memory -----------------------------------------------------
CONTEXT_MAX_TURNS=10            # most recent turns sent to the LLM
CONTEXT_MAX_CHARS=8000          # hard cap on prompt history characters
CONTEXT_SUMMARY_ENABLED=false   # summarise overflow into a rolling summary

# --- Persistence -------------------------------------------------------------
# SQLite for local dev/tests. Docker Compose overrides with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./voxflow.db
REDIS_URL=redis://localhost:6379/0
SESSION_STATE_BACKEND=memory    # memory | redis
PERSIST_CONVERSATIONS=true
